# Vapi (Voice AI Platform) - Required
VAPI_PRIVATE_KEY=your_vapi_private_key_here
VAPI_PHONE_ID=your_vapi_phone_id_here

# OpenAI API - Required for dry-run testing
OPENAI_API_KEY=your_openai_api_key_here

# App URL - Required
NEXT_PUBLIC_APP_URL=https://prankai.com

# PayPal (Optional) - For webhook verification in production
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Production Logging (Optional but recommended)
# AXIOM_API_TOKEN=your_axiom_token_here
# AXIOM_DATASET=prankai-production

# Production Rate Limiting (Optional - requires Upstash Redis)
# UPSTASH_REDIS_REST_URL=your_upstash_url_here
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
