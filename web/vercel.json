{
  "framework": "nextjs",
  "rootDirectory": "web",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "template",
          "value": "(?<template>.*)"
        }
      ],
      "destination": "/template/:template",
      "permanent": true
    }
  ]
}
